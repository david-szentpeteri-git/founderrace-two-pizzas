# Copy to .env.local and fill in. Never commit real values.
# In Vercel: test keys for Preview, live Stripe keys for Production only.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API (service role key, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com > API keys
ANTHROPIC_API_KEY=

# Stripe: Developers > API keys (test secret key locally, live secret key in Production only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# P1 and P2
RESEND_API_KEY=
TAVILY_API_KEY=
STATS_KEY=
